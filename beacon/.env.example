# Beacon Brain — Phase 1 data foundation
#
# Copy these into Replit Secrets (Tools -> Secrets). Never commit real values,
# and never expose any of these to the client bundle.

# --- Market data provider (required) ---
# Polygon.io API key. Server-side only.
POLYGON_API_KEY=

# --- Optional tuning (all have safe defaults) ---

# Base URL for the Polygon REST API.
POLYGON_BASE_URL=https://api.polygon.io

# Per-request timeout in milliseconds.
BEACON_HTTP_TIMEOUT_MS=8000

# Max retry attempts for transient failures (network, 5xx, 429).
BEACON_HTTP_MAX_RETRIES=3

# Snapshot older than this is reported as "stale" rather than "fresh".
BEACON_SNAPSHOT_STALE_AFTER_MS=900000

# In-process cache TTL for provider responses.
BEACON_CACHE_TTL_MS=60000

# Price refresh job interval while enabled.
BEACON_PRICE_REFRESH_INTERVAL_MS=300000

# Symbols the scheduled refresh job keeps warm, comma separated.
BEACON_REFRESH_SYMBOLS=NVDA

# Set to "true" to expose the founder-only testing panel routes.
# Leave unset/false in production.
BEACON_ENABLE_FOUNDER_TOOLS=false
